# Copy this file to .env and fill in the values.
# Never commit .env. Never paste a service/admin connection string here.

# auto: send to Azure IoT Hub when a real device connection string is set,
#       otherwise use the local mock sender.
# mock: always simulate the cloud send on this computer. Nothing reaches IoT Hub.
# live: require a device connection string and send with azure-iot-device.
AZURE_MODE=auto

# Device connection string for the IoT Hub identity named edge-gateway-01.
# Azure Portal -> your IoT Hub -> Device management -> Devices
# -> edge-gateway-01 -> Primary connection string.
# It looks like:
# HostName=<hub>.azure-devices.net;DeviceId=edge-gateway-01;SharedAccessKey=<key>
IOTHUB_DEVICE_CONNECTION_STRING=

MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# A device card turns offline when no reading arrives within this many seconds.
DEVICE_OFFLINE_SECONDS=20

# If the gateway stops writing its heartbeat, the dashboard reports it as down.
GATEWAY_STALE_SECONDS=12

FLASK_PORT=5000
